# ~/.zshenv — read by every zsh. Keep it small and side-effect free.

export EDITOR=nvim
export VISUAL=nvim
export SHELL=/usr/bin/zsh
export PAGER=less
export LESS="-R -F -X"
export BAT_THEME=gruvbox-dark
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# PATH
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PNPM_HOME/bin:$HOME/.cargo/bin:$HOME/go/bin:$HOME/.grok/bin:$PATH"

# XDG
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Machine-local secrets (outside the repo, not committed).
[ -r "$HOME/.config/zsh/secrets.zsh" ] && source "$HOME/.config/zsh/secrets.zsh"
