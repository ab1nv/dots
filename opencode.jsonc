{
  "$schema": "https://opencode.ai/config.json",

  // Shell used by the terminal and the shell tool.
  "shell": "/bin/zsh",

  // Format files after write/edit/patch when a formatter is available.
  // Built-ins: ruff (.py), gofmt (.go), shfmt (.sh), prettier/biome (JS/TS with project deps).
  "formatter": true,

  // Check for updates and notify before installing.
  "update": "notify",

  // Keep context under control automatically.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    }
  },

  // OpenCode V2 plugins. Kept outside .opencode/plugins/ so they load exactly
  // once (global config + project discovery would otherwise double-load them).
  "plugins": [
    "/home/abhinav/projects/dots/.opencode/context-mode",
    "/home/abhinav/projects/dots/.opencode/langfuse",
    "opencode-gemini-auth@latest",
    "@mohak34/opencode-notifier@latest"
  ],

  "mcp": {
    "servers": {
      // context-mode: sandbox execution + FTS5 knowledge base + session memory.
      // codemode:false keeps context-mode_ctx_* tools directly callable.
      "context-mode": {
        "type": "local",
        "command": ["context-mode"],
        "environment": {
          "CONTEXT_MODE_PLATFORM": "opencode"
        },
        "codemode": false,
        "timeout": {
          "startup": 45000
        }
      },

      // Exa: hosted web search and fetch MCP. Free plan; the agent falls back to
      // web-access when the free quota is exhausted. Key comes from EXA_API_KEY.
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      },

      // web-access: merged web MCP (Hound engine + retrieval/source_check layer).
      "web-access": {
        "type": "local",
        "command": ["web-access"],
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "execution": 300000
        }
      }
    }
  },

  "permissions": [
    { "action": "context-mode_*", "resource": "*", "effect": "allow" },
    { "action": "exa_*", "resource": "*", "effect": "allow" }
  ]
}
