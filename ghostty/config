# Ghostty — minimal gruvbox setup

theme = Gruvbox Dark Hard
font-family = JetBrainsMono Nerd Font
font-size = 11

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = false
gtk-titlebar = false
maximize = true

background-opacity = 0.96
cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

shell-integration = zsh

# Force zsh. Without this, Ghostty uses $SHELL, which can still be bash in a
# desktop session that predates `chsh`.
command = /usr/bin/zsh
