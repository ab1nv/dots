{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "plugins": ["*"]
}
